{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,
  "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/window", "custom/dns"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "memory", "bluetooth", "network", "pulseaudio", "battery", "custom/power"],
  "custom/arch": {
      "format": " ",
      "tooltip": true,
      "tooltip-format": "Rofi",
      "on-click": "pkill -x rofi || rofi -show drun -show-icons"
   },
   "hyprland/workspaces": {
      "on-click": "activate",
      "format": "{id}",
         "persistent-workspaces": {
	 "*": 5
      }
   },
   "hyprland/window": {
      "format": "{}",
      "max-length": 45
   },
   "custom/dns": {
      "tooltip": true
   },
   "clock": {
      "format": "󰥔 {:L%A %d %b %I:%M %p}",
      "format-alt": "󰥔 {:L%A %d %b %H:%M}",
      "tooltip": false,
   },
   "network": {
      "format-wifi": "󰤨 {essid}",
      "format-ethernet": "󰀂 WIRED",
      "format-disconnected": "󰤮 OFFLINE",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}",
      "tooltip-format-ethernet": "Wired\n⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}",
      "interval": 3,
      "onclick": "alacritty -e nmtui"
   },
   "memory": {
      "interval": 30,
      "format": " {}%",
      "max-length": 10
   },
   "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": " Muted",
      "format-icons": {
         "headphones": "",
	     "default": ["", "", ""]
      },
      "scroll-step": 5,
      "on-click": "pavucontrol"
   },
   "battery": {
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-discharging": "{icon} {capacity}%",
      "format-plugged": " {capacity}%",
      "format-full": "󰂅 100%",
      "format-icons": {
         "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
         "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
      },
      "interval": 5,
      "states": {
         "warning": 20,
         "critical": 10,
      }
   },
   "custom/power": {
      "format": "󰐦",
      "tooltip": false,
      "on-click": "pkill -x wlogout || wlogout"
   },
   "bluetooth": {
      "format": "󰂲",
      "format-connected": "󰂱 {device_alias}",
      "format-disabled": "󰂲",
      "format-off": "󰂲",
      "tooltip-format": "{device_alias}",
      "on-click": "alacritty -e bluetui"
   },
}
